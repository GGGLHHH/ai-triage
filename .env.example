# 复制为 .env 使用(.env 已被 .gitignore 挡着)。两个变量都是可选的 —— 不建 .env 也能跑,
# vite.config.ts 里的兜底值就是下面这两行。

# 后端(baserust)的 origin。vite 有两处读它,不必再分别改:
#   1. dev server 的 /api proxy 转发目标
#   2. `pnpm generate` 的 codegen 契约源(${BACKEND_ORIGIN}/api-docs/openapi.json)
# 跟着 baserust 那边 .env 的 BIND_ADDR 走 —— 改了它这里就得改,否则 proxy 打空。
BACKEND_ORIGIN=http://localhost:8137

# 本前端 vite dev server 的端口(`pnpm dev`)。
# 临时改用 `pnpm dev --port 1234` 即可,CLI flag 优先级高于此处。
FRONTEND_DEV_PORT=7621

# DeepSeek(AI 预分诊)。默认模型走它时必填,别提交真实 key。
DEEPSEEK_API_KEY=
# 换成其他 OpenAI 兼容服务(院内 vLLM 的 Qwen 等)才填:设了 AI_BASE_URL 就不再用 DeepSeek。
# AI_MODEL 不设时是 deepseek-v4-flash;内网服务没有 key 也要给 AI_API_KEY 填个占位值。
# AI_BASE_URL=http://10.240.242.30:6512/v1
# AI_MODEL=qwen3
# AI_API_KEY=none

# 向量知识库:pgvector 在 docker-compose.yml,embedding 走 OpenAI 兼容接口(默认硅基流动 bge-m3,需 key)。
KB_EMBED_API_KEY=
# 以下可不填,默认值如下;改了 pgvector 端口要和 KB_DB_PORT 一致。换本地模型改 URL / MODEL。
# KB_DATABASE_URL=postgres://kb:kb@127.0.0.1:5493/kb
# KB_EMBED_URL=https://api.siliconflow.cn/v1
# KB_EMBED_MODEL=BAAI/bge-m3

# 院内 HIS(科室、医生主数据,给 AI 的 his_* 工具)。只在院内网可达;不设 HIS_MODE 就不接 HIS。
#   soap:南山 JHIPLIB 服务总线(无账号,靠内网)  rest:接口文档的 /login + /master/*  mock:本地假数据
# HIS_MODE=soap
# HIS_URL=http://10.241.129.19/soap/JHIPLIB.SOAP.BS.Streambus.cls
# HIS_USERNAME=
# HIS_PASSWORD=
