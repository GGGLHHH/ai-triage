# 生产配置。deploy.sh 首次运行会复制成 .env 并生成随机 KB_DB_PASSWORD,填好下面的 key 再运行一次。

# 对外端口(nginx)
HTTP_PORT=80

# 向量库密码。库只在容器内部网络,不对外;库建好后别再改(改了 app 就连不上)
KB_DB_PASSWORD=

# 对话模型:默认 DeepSeek,填 key
DEEPSEEK_API_KEY=
# 或改连院内 OpenAI 兼容服务(填了 AI_BASE_URL 就不用 DeepSeek);没有 key 也给 AI_API_KEY 填个占位值
# AI_BASE_URL=http://10.240.242.30:6512/v1
# AI_MODEL=qwen3
# AI_API_KEY=none

# embedding(把患者问题转向量):必须和打包时生成知识库的模型一致(bge-m3)
KB_EMBED_API_KEY=
# 默认硅基流动;改连院内 bge-m3 时填下面两行,KB_EMBED_API_KEY 可空
# KB_EMBED_URL=http://10.240.242.30:6509/v1
# KB_EMBED_MODEL=bge-m3

# 院内 HIS(科室、医生主数据,给 AI 的 his_* 工具)。只在院内网可达;不设 HIS_MODE 就不接 HIS。
#   soap:南山 JHIPLIB 服务总线(无账号,靠内网)  rest:接口文档的 /login + /master/*  mock:本地假数据
# HIS_MODE=soap
# HIS_URL=http://10.241.129.19/soap/JHIPLIB.SOAP.BS.Streambus.cls
# HIS_USERNAME=
# HIS_PASSWORD=
